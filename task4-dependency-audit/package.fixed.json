{
  "name": "vulnerable-node-app",
  "version": "1.0.0",
  "description": "Remediated manifest. Verified with npm audit: 0 vulnerabilities (was 23 across 45 advisories).",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "audit:report": "python3 audit_report.py --run --csv reports/vulnerabilities.csv --json reports/audit-report.json"
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "dotenv": "^8.2.0",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "mocha": "^12.0.2"
  }
}
